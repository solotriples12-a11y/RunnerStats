# Password de acceso (HTTP basic auth, cualquier usuario).
# Si está vacío la web devuelve 401 a todo: son datos de salud, falla cerrado.
RUNNERSTATS_PASSWORD=

# Ruta del SQLite. En producción debe apuntar al volumen persistente de
# Coolify, o cada redeploy borraría todo el histórico.
RUNNERSTATS_DB=/app/data/runnerstats.db
